# ================================================================================
# IU2NAF - Meteo Live - Lombardia | OpenArpa — Configurazione PRODUZIONE
# ================================================================================

# Immagini Container
BACKEND_IMAGE=gitea.iu2naf.net:3000/iu2naf/openarpa-backend:latest
FRONTEND_IMAGE=gitea.iu2naf.net:3000/iu2naf/openarpa-frontend:latest

# Porta di ascolto principale dell'applicazione (es. http://IP_DEL_SERVER:8085)
HOST_PORT=8085

# Porte locali interne esposte (modifica solo in caso di conflitti con altri servizi)
FRONTEND_PORT=3000
BACKEND_PORT=8000
POSTGRES_PORT=6432

# Credenziali Database PostgreSQL / PostGIS (IMPORTANTE: Cambia la password in produzione)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CAMBIA_QUESTA_PASSWORD_SICURA
POSTGRES_DB=openarpa

# Parametri Operativi Backend FastAPI
API_ONLY_MODE=false
SYNC_INTERVAL_SECONDS=300

# Notifiche Bot Telegram (Opzionale)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
